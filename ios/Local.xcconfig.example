// Copy to Local.xcconfig (ignored by git) and put your team ID in. Never commit the real file.
// Team ID: Xcode → Settings → Accounts → your Apple ID → team.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// Optional: Gemini for designing garments on the phone (https://aistudio.google.com/apikey). Without it, demo mode.
// GEMINI_API_KEY = your-key
// Optional: ElevenLabs, for spoken answers to questions during the fitting.
// ELEVENLABS_API_KEY = your-key
