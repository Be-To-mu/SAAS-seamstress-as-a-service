// Copy to Local.xcconfig (ignored by git). Never commit the real file.
// Team ID: Xcode → Settings → Accounts → your Apple ID → team.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// The Mac running `bodyfit serve`, as the phone sees it on your Wi-Fi ("/$()/" keeps xcconfig from reading // as a comment).
BODYFIT_SERVICE_URL = http:/$()/192.168.1.10:8000
