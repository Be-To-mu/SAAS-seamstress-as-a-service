# Copy to .env.local and fill in. The app runs without these in demo mode.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id to use for reading photos and generating features.
# gemini-4-argon is the model for the Google DeepMind bounty. gemini-2.5-flash is no longer available to new keys.
GEMINI_MODEL=gemini-4-argon

# MongoDB Atlas connection string. The app uses three collections: garments, recipes, bodies.
# Vector Search indexes (optional, cosine fallback works without them): see atlas/indexes.json
MONGODB_URI=
MONGODB_DB=saas

# Embedding model for Atlas Vector Search. Must stay 768 dimensions (see src/lib/embed.ts).
GEMINI_EMBED_MODEL=gemini-embedding-001
